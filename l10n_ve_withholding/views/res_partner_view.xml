<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_partner_form">
        <field name="name">res.partner.form.inherit</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <field name="property_supplier_payment_term_id" position="after">
                <field name="l10n_ve_vat_retention" string="Retención I.V.A" />
                <field name="l10n_ve_seniat_partner_type_id" />
            </field>
            <xpath expr="//group[@name='purchase']" position="after">
                <group name="regimen_islr" string="Régimen ISLR Aplicar" invisible="not l10n_ve_seniat_partner_type_id">
                    <group>
                        <field
                            name="l10n_ve_seniat_regimen_islr_ids"
                            string="RÉGIMEN ISLR APLICAR"
                            nolabel="1"
                            colspan="4"
                            invisible="not l10n_ve_seniat_partner_type_id"
                            />
                    </group>
                </group>
            </xpath>
            <group id="invoice_send_settings" position="after">
                <group string="Purchase Withholding" invisible="'VE' not in fiscal_country_codes or not is_company">
                    <field name="l10n_ve_partner_tax_ids" nolabel="1" colspan="2" widget="auto_save_res_partner">
                        <list editable="top">
                            <field name="tax_id"
                                options="{'no_create': True, 'no_open': True}"
                                domain="[('l10n_ve_withholding_payment_type', '=', 'supplier')]"
                                />
                        </list>
                    </field>
                </group>
            </group>
        </field>
    </record>
</odoo>