<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_saleorder_document_inherit" inherit_id="stock.report_picking">
            <xpath expr="//div[contains(@class, 'o_report_stockpicking_operations')]" position="before">
                <style>
                    .watermark {
                        position: absolute;
                        opacity: 0.1;
                        font-size: 38px;
                        transform: rotate(-30deg);
                        color: #616161;
                        z-index: 0;
                        width: 100%;
                        text-align: center;
                        pointer-events: none;
                        font-weight: bold;
                    }
                    .watermark-block {
                        position: absolute;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                    }
                </style>
                <div class="watermark-block">
                    <div class="watermark" style="top: 0px;">DOCUMENTO SIN DERECHO A CRÉDITO FISCAL</div>
                    <div class="watermark" style="top: 150px;">DOCUMENTO SIN DERECHO A CRÉDITO FISCAL</div>
                    <div class="watermark" style="top: 300px;">DOCUMENTO SIN DERECHO A CRÉDITO FISCAL</div>
                    <div class="watermark" style="top: 450px;">DOCUMENTO SIN DERECHO A CRÉDITO FISCAL</div>
                    <div class="watermark" style="top: 600px;">DOCUMENTO SIN DERECHO A CRÉDITO FISCAL</div>
                    <div class="watermark" style="top: 750px;">DOCUMENTO SIN DERECHO A CRÉDITO FISCAL</div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>