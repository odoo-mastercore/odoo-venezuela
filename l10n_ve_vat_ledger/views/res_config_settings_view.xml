<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_vat_ledger" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.vat.ledger</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="inside">
                <div id="l10n_ve_vat_ledger_import_columns"
                     class="col-12 col-lg-6 o_setting_box"
                     groups="account.group_account_manager">
                    <div class="o_setting_left_pane">
                        <field name="l10n_ve_vat_ledger_show_import_columns"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="l10n_ve_vat_ledger_show_import_columns"/>
                        <span class="fa fa-lg fa-building-o"
                              title="Values set here are company-specific."
                              aria-label="Values set here are company-specific."
                              groups="base.group_multi_company"
                              role="img"/>
                        <div class="text-muted">
                            Segmenta en las columnas de importación del Libro IVA de compras
                            las facturas de proveedores marcados como compra de importación.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
