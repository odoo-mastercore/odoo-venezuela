<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_vat_ledger" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.vat.ledger</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="venezuela_localization_section" position="attributes">
                <attribute name="invisible">0</attribute>
            </div>
            <xpath expr="//block[@id='venezuela_localization']" position="inside">
                <setting id="l10n_ve_vat_ledger_import_columns" string="Libro IVA" company_dependent="1">
                    <div class="content-group" invisible="country_code != 'VE'">
                        <div class="row mt16">
                            <div class="o_setting_left_pane">
                                <field name="l10n_ve_vat_ledger_show_import_columns"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="l10n_ve_vat_ledger_show_import_columns"/>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."/>
                                <div class="text-muted">
                                    Agrega columnas de importación (planilla, fecha y expediente) al
                                    Libro IVA de compras y segmenta en ellas las facturas de proveedores
                                    marcados como compra de importación.
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
