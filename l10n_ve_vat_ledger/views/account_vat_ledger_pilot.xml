<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vat_ledger_pilot_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.vat.ledger.pilot.wizard.form</field>
        <field name="model">l10n_ve.vat.ledger.pilot.wizard</field>
        <field name="arch" type="xml">
            <form string="Libro IVA Piloto">
                <group>
                    <group>
                        <field name="ledger_type" readonly="1"/>
                        <field name="company_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id), ('type', '=', ledger_type)]"/>
                    </group>
                </group>
                <notebook>
                    <page string="Vista previa">
                        <field name="line_ids" nolabel="1">
                            <list create="0" delete="0" edit="0">
                                <field name="sequence"/>
                                <field name="invoice_date"/>
                                <field name="note_type"/>
                                <field name="move_name"/>
                                <field name="control_number"/>
                                <field name="partner_name"/>
                                <field name="partner_vat"/>
                                <field name="base_16" sum="Total"/>
                                <field name="tax_16" sum="Total"/>
                                <field name="base_8" sum="Total"/>
                                <field name="tax_8" sum="Total"/>
                                <field name="base_15" sum="Total"/>
                                <field name="tax_15" sum="Total"/>
                                <field name="exempt" sum="Total"/>
                                <field name="amount_total" sum="Total"/>
                                <field name="withholding" sum="Total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Totales">
                        <group>
                            <group>
                                <field name="total_base_16" readonly="1"/>
                                <field name="total_tax_16" readonly="1"/>
                                <field name="total_base_8" readonly="1"/>
                                <field name="total_tax_8" readonly="1"/>
                                <field name="total_base_15" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_tax_15" readonly="1"/>
                                <field name="total_exempt" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                                <field name="total_withholding" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                <footer>
                    <button name="action_load_preview" string="Actualizar" type="object" class="oe_highlight"/>
                    <button name="action_export_xlsx" string="Exportar XLSX" type="object"/>
                    <button name="action_export_pdf" string="Exportar PDF" type="object"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vat_ledger_pilot_purchase" model="ir.actions.act_window">
        <field name="name">Libro IVA Compras (Piloto)</field>
        <field name="res_model">l10n_ve.vat.ledger.pilot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_ledger_type': 'purchase'}</field>
    </record>

    <record id="action_vat_ledger_pilot_sale" model="ir.actions.act_window">
        <field name="name">Libro IVA Ventas (Piloto)</field>
        <field name="res_model">l10n_ve.vat.ledger.pilot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_ledger_type': 'sale'}</field>
    </record>

    <menuitem
        id="menu_account_purchase_vat_ledger_pilot"
        action="action_vat_ledger_pilot_purchase"
        parent="menu_seniat_reports"
        sequence="8"
    />

    <menuitem
        id="menu_account_sale_vat_ledger_pilot"
        action="action_vat_ledger_pilot_sale"
        parent="menu_seniat_reports"
        sequence="9"
    />
</odoo>
