<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_account_move_form" model="ir.ui.view">
        <field name="name">inherit.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']//field[@name='company_id']" position="after">
                <field name="currency_rate_ve"/>
            </xpath>
        </field>
    </record>
</odoo>
