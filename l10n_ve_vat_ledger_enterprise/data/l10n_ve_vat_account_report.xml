            <record id="ve_vat_sales_report_col_base_15" model="account.report.column">
                <field name="name">Base 15%</field>
                <field name="expression_label">base_15</field>
            </record>
            <record id="ve_vat_sales_report_col_tax_15" model="account.report.column">
                <field name="name">IVA 15%</field>
                <field name="expression_label">tax_15</field>
            </record>
            <record id="ve_vat_sales_report_col_exempt" model="account.report.column">
                <field name="name">Exento</field>
